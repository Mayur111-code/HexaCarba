# Server
PORT=5000
NODE_ENV=development

# Database — either MONGO_URI or MONGODB_URI is accepted
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hexacarb?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hexacarb?retryWrites=true&w=majority

# URLs — public URLs of this API and of the frontend
# SERVER_URL is used to build absolute URLs for locally stored uploads
# (required on Render so /uploads/... images and PDFs resolve correctly).
SERVER_URL=https://your-api.onrender.com
CLIENT_URL=https://your-frontend.vercel.app

# Auth
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Cloudinary (optional — falls back to local storage in ./uploads when unset/failing)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Proxy / rate limiting
# How many proxy hops Express should trust (1 = Render/Vercel/nginx single hop).
# Set to false/0 only when running without any reverse proxy.
TRUST_PROXY=1
RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=20

# Uploads
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=5242880

# Seed admin
ADMIN_SEED_EMAIL=admin@hexacarb.com
ADMIN_SEED_PASSWORD=Admin@123
