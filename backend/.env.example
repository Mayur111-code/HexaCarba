# Server
PORT=5000
NODE_ENV=development

# Database — either MONGO_URI or MONGODB_URI is accepted
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hexacarb?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hexacarb?retryWrites=true&w=majority

# URLs — public URL of this API
CLIENT_URL=https://your-frontend.vercel.app

# Auth
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ImageKit (REQUIRED — all images and PDFs are stored here; nothing is kept
# on the server filesystem). Get credentials from https://dashboard.imagekit.io
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_upload_path

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Proxy / rate limiting
# How many proxy hops Express should trust (1 = Render/Vercel/nginx single hop).
# Set to false/0 only when running without any reverse proxy.
TRUST_PROXY=1
RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=20

# Seed admin
ADMIN_SEED_EMAIL=admin@hexacarb.com
ADMIN_SEED_PASSWORD=Admin@123
