# Base URL of the HEXACARB backend API.
# - Production (Vercel/Render): absolute URL of the deployed API, no trailing slash.
# - Local development: either the absolute backend URL, or omit/substitute so the
#   Vite dev proxy (server.proxy in vite.config.js) forwards /api and /uploads.
VITE_API_URL=https://your-api.onrender.com

# Optional: override the backend URL that the Vite dev proxy forwards to.
# VITE_PROXY_TARGET=http://localhost:5000